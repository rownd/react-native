{
  "name": "@supertokens/rownd-react-native",
  "version": "4.0.2",
  "description": "test",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "rownd-react-native.podspec",
    "expo",
    "app.plugin.js",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "example:server": "node example-server/server.mjs",
    "bootstrap": "yarn example && yarn && yarn example pods",
    "test:integration:harness": "cd ../supertokens-rownd-android && npm run test:integration:harness",
    "test:integration:android:build": "cd example/android && ./gradlew :app:assembleDebugAndroidTest",
    "test:integration:android": "cd ../supertokens-rownd-android && npx tsx ../supertokens-rownd-react-native/test-server/with-harness.ts -- sh -c 'cd ../supertokens-rownd-react-native/example/android && ./gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.harnessUrl=$ANDROID_HARNESS_URL'"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/rownd/react-native",
  "author": "rownd <michael@rownd.io> (https://github.com/rownd/react-native)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rownd/react-native"
  },
  "homepage": "https://github.com/rownd/react-native",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@arkweid/lefthook": "^0.7.7",
    "@babel/eslint-parser": "^7.18.2",
    "@commitlint/config-conventional": "^17.0.2",
    "@react-native-community/eslint-config": "^3.0.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@supertokens-plugins/rownd-nodejs": "0.5.0",
    "@types/jest": "^28.1.2",
    "@types/react": "17.0.21",
    "@types/react-native": "0.68.0",
    "@types/react-test-renderer": "^17.0.2",
    "commitlint": "^17.0.2",
    "cors": "^2.8.5",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "express": "^5.1.0",
    "expo": "~52.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-native": "0.68.2",
    "react-native-builder-bob": "^0.18.3",
    "react-test-renderer": "17.0.2",
    "release-it": "^15.0.0",
    "supertokens-node": "^24.0.2",
    "typescript": "^4.5.2"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--auth-type=web"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "parser": "@babel/eslint-parser",
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ],
      "@typescript-eslint/no-unused-vars": "off"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@supertokens/rownd-react": "0.1.0-beta.3"
  }
}
